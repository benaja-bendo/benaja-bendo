---
import Base from '../../layouts/Base.astro';
import LigneRealisation from '../../components/LigneRealisation.astro';
import {
  TYPES_REALISATION,
  getRealisations,
  taxonomiesRealisations,
} from '../../lib/contenu';

const realisations = await getRealisations();
const { domaines, techs } = await taxonomiesRealisations();
const aDesFiltres = domaines.length > 0 || techs.length > 0;

// Trois groupes, par type de travail (30/09/2026). L'ordre des entrées vient
// de getRealisations(), déjà trié par groupe : on ne réordonne rien ici.
const groupes = TYPES_REALISATION.map((type) => ({
  ...type,
  entrees: realisations.filter((r) => r.data.type === type.cle),
})).filter((groupe) => groupe.entrees.length > 0);

// /experiences#aife et /experiences#france-travail ont été envoyés dans des
// candidatures. /experiences redirige ici depuis le 30/09/2026 et le
// navigateur réapplique le fragment : ces deux lignes doivent donc porter
// ces ancres (voir /notes/fragment-url-et-redirections).
const ANCRES: Record<string, string> = {
  'aife-microservices': 'aife',
  'france-travail-collecte': 'france-travail',
};
---

<Base
  title="Réalisations · Bénaja Bendo-Matondo"
  description="Mes produits, mes postes en entreprise et les projets menés avec d’autres : pour chacun, mon rôle, où en est le projet et ce que j’en retiens."
>
  <section class="container">
    <p class="eyebrow">Réalisations</p>
    <h1>Ce que j’ai construit</h1>
    <p class="lead">
      Mes propres produits, mes postes en entreprise, au Congo puis en
      France, et des projets menés avec d’autres.
    </p>

    {/* A6 — le rail de filtres est passé du bas vers le haut le 25/08/2026 :
        « Java » ou « Spring Boot » est la façon dont un recruteur cherche. */}
    {
      aDesFiltres && (
        <>
          {domaines.length > 0 && (
            <div class="filtres">
              <p class="etiq">Par domaine</p>
              <ul class="chips chips-compte" aria-label="Domaines">
                {domaines.map((groupe) => (
                  <li>
                    <a href={`/realisations/domaine/${groupe.slug}`}>
                      {groupe.label}
                      <span class="compte">{groupe.entrees.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {techs.length > 0 && (
            <div class="filtres">
              <p class="etiq">Par technologie</p>
              <ul class="chips chips-compte" aria-label="Technologies">
                {techs.map((groupe) => (
                  <li>
                    <a href={`/realisations/tech/${groupe.slug}`}>
                      {groupe.label}
                      <span class="compte">{groupe.entrees.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </>
      )
    }
  </section>

  {
    groupes.map((groupe) => (
      <section class="container" aria-labelledby={`groupe-${groupe.cle}`}>
        <h2 id={`groupe-${groupe.cle}`}>{groupe.label}</h2>
        <div class="lignes">
          {groupe.entrees.map((realisation) => (
            <LigneRealisation
              realisation={realisation}
              niveau={3}
              ancre={ANCRES[realisation.id]}
            />
          ))}
        </div>
      </section>
    ))
  }

  {/* Un index vide est un état possible, pas une page cassée. */}
  {
    realisations.length === 0 && (
      <section class="container">
        <p class="etat-vide">Rien de publié pour l’instant.</p>
      </section>
    )
  }

  <section class="container">
    <h2>Un poste ou un projet de ce genre&nbsp;?</h2>
    <p class="lead muted">Le plus simple, c’est de m’écrire.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/contact">Me contacter</a>
      <a class="btn btn-ghost" href="/cv">Voir le CV</a>
    </div>
    <p class="haut-de-page"><a href="#contenu">↑ Haut de page</a></p>
  </section>
</Base>
