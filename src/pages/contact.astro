---
import Base from '../layouts/Base.astro';

const voies = [
  {
    titre: 'Email',
    period: 'La voie directe',
    points: [
      'Pour une offre, une mission, une question technique',
      'Aucun intermédiaire, aucun formulaire, aucun suivi',
    ],
    href: 'mailto:contact@benaja-bendo.fr',
    cta: 'contact@benaja-bendo.fr',
    externe: false,
  },
  {
    titre: 'LinkedIn',
    period: 'La prise de contact classique',
    points: [
      'Si votre process passe par là, c’est aussi bien',
      'Profil au nom de Bénaja Bendo-Matondo',
    ],
    href: 'https://www.linkedin.com/in/benaja-bendo',
    cta: 'linkedin.com/in/benaja-bendo',
    externe: true,
  },
  {
    titre: 'GitHub',
    period: 'Juger sur pièces',
    points: [
      'Les dépôts Mibeko : API, ingestion, dashboard, apps mobiles',
      'L’infrastructure du VPS : Ansible, Docker, Traefik',
    ],
    href: 'https://github.com/benaja-bendo',
    cta: 'github.com/benaja-bendo',
    externe: true,
  },
];
---

<Base
  title="Contact — Bénaja Bendo-Matondo"
  description="Écrivez-moi à contact@benaja-bendo.fr. Développeur fullstack Java / Spring Boot · React, disponible en CDI à partir du 28 septembre 2026, à Bordeaux."
>
  <section class="hero container">
    <p class="eyebrow">Contact</p>
    <h1>Écrivez-moi.</h1>

    <div class="hero-proof">
      <p>
        Le plus simple reste l’email : <a href="mailto:contact@benaja-bendo.fr">contact@benaja-bendo.fr</a>.
        Vous ne trouverez pas de formulaire sur cette page — ce site est
        entièrement statique et ne collecte rien. Un email part directement chez
        moi, et vous gardez une trace de ce que vous avez envoyé.
      </p>
    </div>

    <p class="lead">
      Disponible en CDI à partir du <mark class="mark-time">28&nbsp;septembre&nbsp;2026</mark>,
      à Bordeaux&nbsp;/&nbsp;Mérignac (33).
    </p>

    <div class="cta-row">
      <a class="btn btn-primary" href="mailto:contact@benaja-bendo.fr">
        Écrire un email
      </a>
      <a
        class="btn btn-ghost"
        href="https://www.linkedin.com/in/benaja-bendo"
        rel="me noopener"
      >
        LinkedIn
      </a>
    </div>
  </section>

  <section class="container">
    <p class="eyebrow">Les voies</p>
    <h2>Où me joindre</h2>
    <div class="cards">
      {voies.map((v) => (
        <article class="card">
          <h3>{v.titre}</h3>
          <span class="period">{v.period}</span>
          <ul>
            {v.points.map((p) => <li>{p}</li>)}
          </ul>
          <a href={v.href} rel={v.externe ? 'me noopener' : undefined}>
            {v.cta} →
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="container">
    <p class="eyebrow">Pratique</p>
    <h2>Ce qui m’aide à répondre utilement</h2>
    <div class="prose">
      <p>
        Rien d’obligatoire, un message court suffit. Mais si vous écrivez pour un
        poste, trois éléments évitent un aller-retour : <strong>le contexte</strong> —
        l’entreprise, l’équipe, ce qu’elle construit ; <strong>la stack</strong> réellement
        utilisée au quotidien ; <strong>le lieu</strong> et le rythme de présence
        attendu.
      </p>
      <p>
        Si un message reste sans réponse, il est probablement tombé dans les
        indésirables : relancez-moi via <a href="https://www.linkedin.com/in/benaja-bendo" rel="me noopener">LinkedIn</a>.
      </p>
    </div>

    <div class="cta-row">
      <a class="btn btn-primary" href="/mibeko">Voir Mibeko</a>
      <a class="btn btn-ghost" href="/experiences">Mes expériences</a>
    </div>
  </section>
</Base>
