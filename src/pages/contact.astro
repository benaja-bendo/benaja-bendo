---
import Base from '../layouts/Base.astro';
import { CONTACT, DISPONIBILITE } from '../lib/parcours';

const intentions = [
  {
    titre: 'Vous recrutez',
    index: '01',
    resume:
      'Vous cherchez un développeur fullstack capable de prendre un sujet métier, de le construire et de l’accompagner en production.',
    points: [
      `Disponible en CDI à partir du ${DISPONIBILITE.texte}`,
      `Bordeaux / Mérignac · Java / Spring Boot · fullstack`,
      'CV web imprimable et parcours détaillé',
    ],
    href: `mailto:${CONTACT.email}?subject=Opportunité%20CDI`,
    cta: 'Présenter un poste',
    preuveHref: '/cv',
    preuve: 'Consulter le CV',
  },
  {
    titre: 'Vous avez un besoin technique',
    index: '02',
    resume:
      'Mon expérience répond surtout aux besoins qui relient produit, back-end et exploitation, avec un résultat concret à livrer.',
    points: [
      'API ou service métier à construire ou fiabiliser',
      'Processus manuel à automatiser et rendre observable',
      'Produit web ou mobile à mener jusqu’en production',
    ],
    href: `mailto:${CONTACT.email}?subject=Besoin%20technique`,
    cta: 'Décrire le besoin',
    preuveHref: '/realisations',
    preuve: 'Voir les réalisations',
  },
];
---

<Base
  title="Contact — Bénaja Bendo-Matondo"
  description={`Écrivez-moi à ${CONTACT.email}. Développeur fullstack Java / Spring Boot · React, disponible en CDI à partir du ${DISPONIBILITE.texte}, à Bordeaux.`}
>
  <section class="hero container">
    <p class="eyebrow">Contact</p>
    <h1>Écrivez-moi.</h1>

    <div class="hero-proof">
      <p>
        Une offre, une mission ciblée ou une question technique&nbsp;:
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>. Pas de formulaire
        ni de suivi&nbsp;: votre message arrive directement chez moi.
      </p>
    </div>

    <p class="lead">
      Côté emploi&nbsp;: disponible en CDI à partir
      du <mark class="mark-time mark-ponct">{DISPONIBILITE.texte}</mark>, à
      &nbsp;{DISPONIBILITE.lieu}.
    </p>

    <div class="cta-row">
      <a class="btn btn-primary" href={`mailto:${CONTACT.email}`}>
        Écrire un email
      </a>
      <a
        class="btn btn-ghost"
        href="https://www.linkedin.com/in/benaja-bendo"
        rel="me noopener"
      >
        LinkedIn
      </a>
    </div>
  </section>

  <section class="container">
    <p class="eyebrow">Deux points de départ</p>
    <h2>Choisissez ce qui vous amène</h2>
    <p class="lead muted">
      Vous n’avez pas à parcourir tout le site avant d’écrire. Voici les faits
      et les preuves utiles selon votre contexte.
    </p>
    <div class="cards contact-intents">
      {intentions.map((intention) => (
        <article class="card intent-card">
          <div class="door-card-head">
            <span class="period">Point de départ</span>
            <span class="door-index" aria-hidden="true">{intention.index}</span>
          </div>
          <h3>{intention.titre}</h3>
          <p class="card-resume">{intention.resume}</p>
          <ul>
            {intention.points.map((point) => <li>{point}</li>)}
          </ul>
          <div class="intent-actions">
            <a class="btn btn-primary" href={intention.href}>{intention.cta}</a>
            <a class="intent-proof" href={intention.preuveHref}>{intention.preuve} →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container">
    <p class="eyebrow">Un message court suffit</p>
    <h2>Les informations qui font gagner un aller-retour</h2>
    <div class="contact-briefs">
      <article>
        <p class="etiq">Pour un poste</p>
        <h3>Le cadre de travail</h3>
        <p>
          L’entreprise, ce que construit l’équipe, la stack réellement utilisée,
          le lieu et le rythme de présence attendu.
        </p>
      </article>
      <article>
        <p class="etiq">Pour un besoin technique</p>
        <h3>Le problème avant la solution</h3>
        <p>
          Ce qui bloque aujourd’hui, les utilisateurs concernés, l’échéance et
          les contraintes déjà connues. Le choix technique peut venir ensuite.
        </p>
      </article>
    </div>

    <div class="prose contact-secondary">
      <p>
        Pour juger avant d’écrire&nbsp;: le <a href="/cv">CV</a> synthétise, les
        <a href="/realisations">réalisations</a> situent mon rôle, et
        <a href="/etudes/mibeko#preuves-titre">l’étude Mibeko</a> relie le produit,
        les stores et six dépôts publics.
      </p>
      <p>
        Si un message reste sans réponse, il est probablement tombé dans les
        indésirables&nbsp;: relancez-moi via <a href="https://www.linkedin.com/in/benaja-bendo" rel="me noopener">LinkedIn</a>.
      </p>
    </div>

    <div class="cta-row">
      <a class="btn btn-primary" href={`mailto:${CONTACT.email}`}>Écrire un email</a>
      <a class="btn btn-ghost" href="/cv">Voir le CV</a>
    </div>
  </section>
</Base>
