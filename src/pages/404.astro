---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
---

<Base
  title="Page introuvable (404) — Bénaja Bendo-Matondo"
  description="Cette page n’existe pas ou plus. Voici les trois endroits utiles du site."
>
  <section class="container notfound">
    <p class="code">404</p>
    <h1>Cette page a changé d’adresse</h1>
    <p class="lead muted">
      Le lien est cassé, ou la page a été retirée — ici, un contenu périmé est
      supprimé, pas laissé à l’abandon. Les trois espaces du site&nbsp;:
    </p>
    {/* Le seul visage du site, et il n'apparaît qu'ici. docs/05 §4 réserve à
        la 404 « la seule vraie fantaisie » ; un personnage perplexe y est à sa
        place, alors qu'il transformerait n'importe quelle autre page en
        illustration de catalogue. Sans cadre : c'est un dessin, pas une pièce. */}
    <Illustration
      nom="bald-person-looking-confused"
      legende="Moi aussi je cherche."
      cadre="nu"
      taille="petit"
      class="illustration-404"
    />

    <div class="cta-row cta-center">
      <a class="btn btn-primary" href="/realisations">Réalisations</a>
      <a class="btn btn-ghost" href="/etudes">Études de cas</a>
      <a class="btn btn-ghost" href="/notes">Notes</a>
    </div>
    <p class="retour"><a href="/">← Retour à l’accueil</a></p>
  </section>
</Base>
