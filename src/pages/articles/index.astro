---
import Base from '../../layouts/Base.astro';
import LigneNote from '../../components/LigneNote.astro';
import { getNotes, sujetsNotes } from '../../lib/contenu';

const notes = await getNotes();
const { sujets } = await sujetsNotes();
---

<Base
  title="Articles · Bénaja Bendo-Matondo"
  description="Mes articles techniques, datés : des problèmes rencontrés en construisant mes projets, et la façon dont je les ai réglés."
>
  <section class="container">
    <p class="eyebrow">Articles</p>
    <h1>Mes articles</h1>
    <p class="lead">
      Des problèmes que j’ai rencontrés en construisant mes projets, et la
      façon dont je les ai réglés. Chaque article est daté, pour qu’on sache
      s’il est encore à jour.
    </p>

    {/* A6 — même déplacement que sur /realisations : les sujets ouvrent la
        rubrique au lieu de la clore. On cherche un article par son sujet
        (« CSP », « HTTP »), pas en descendant une liste chronologique. */}
    {
      sujets.length > 0 && (
        <div class="filtres">
          <p class="etiq">Par sujet</p>
          <ul class="chips chips-compte" aria-label="Sujets">
            {sujets.map((groupe) => (
              <li>
                <a href={`/articles/sujet/${groupe.slug}`}>
                  {groupe.label}
                  <span class="compte">{groupe.entrees.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="container">
    <div class="lignes">
      {notes.map((note) => <LigneNote note={note} />)}
    </div>

    {
      notes.length === 0 && (
        <p class="etat-vide">
          Aucun article publié pour l’instant. Un article paraît quand il aide à
          retrouver ou comprendre quelque chose, pas à date fixe.
        </p>
      )
    }
  </section>

  {/* A8 — une sortie qui avance, en plus du flux RSS. */}
  <section class="container">
    <h2>Suivre les nouveaux articles</h2>
    <p class="lead muted">Elles arrivent aussi dans le flux RSS, avec mes réalisations.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/rss.xml">Suivre en RSS</a>
      <a class="btn btn-ghost" href="/realisations">Voir mes réalisations</a>
    </div>
    <p class="haut-de-page"><a href="#contenu">↑ Haut de page</a></p>
  </section>
</Base>
