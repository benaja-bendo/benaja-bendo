---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const missions = (await getCollection('etudes'))
  .filter((e) => e.id !== 'mibeko')
  .sort((a, b) => a.data.ordre - b.data.ordre);

const rendered = await Promise.all(
  missions.map(async (e) => ({
    id: e.id,
    data: e.data,
    Content: (await render(e)).Content,
  })),
);
---

<Base
  title="Expériences — Bénaja Bendo-Matondo"
  description="Trois ans chez Capgemini : microservices Java / Spring Boot à l’AIFE, automatisation et décisionnel sur le compte France Travail, plus le parcours web/mobile au Congo."
>
  <section class="container">
    <p class="eyebrow">Expériences professionnelles</p>
    <h1>Du back au décisionnel, en équipe et en production</h1>
    <p class="lead">
      Trois ans chez Capgemini, sur des systèmes exigeants — finances publiques et
      compte France Travail. Ici, les faits et les résultats ; le détail vit dans
      chaque étude de cas.
    </p>
  </section>

  {rendered.map(({ id, data, Content }) => (
    <section class="container" id={id}>
      <p class="eyebrow">{data.periode}</p>
      <h2>{data.titre}</h2>
      {data.sousTitre && <p class="lead muted">{data.sousTitre}</p>}

      {data.chiffres.length > 0 && (
        <ul class="stats">
          {data.chiffres.map((c) => (
            <li>
              <span class="value">{c.valeur}</span>
              <span class="label">{c.label}</span>
            </li>
          ))}
        </ul>
      )}

      <div class="prose">
        <Content />
      </div>

      {data.stack.length > 0 && (
        <ul class="chips">
          {data.stack.map((s) => <li>{s}</li>)}
        </ul>
      )}
    </section>
  ))}

  <section class="container">
    <p class="eyebrow">Avant Capgemini</p>
    <h2>Congo — développeur web & mobile</h2>
    <p class="prose">
      Reconversion de la maintenance industrielle vers le développement : salarié
      chez InfraOne System (2019–2020), puis freelance (2021–2023) à Pointe-Noire.
      Applications mobiles Flutter, API Laravel / Node.js, logiciels livrés à des
      clients réels — du recueil du besoin à la mise en production.
      <a href="/a-propos"> Voir le parcours complet →</a>
    </p>
  </section>
</Base>
