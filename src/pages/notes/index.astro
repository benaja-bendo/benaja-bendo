---
import Base from '../../layouts/Base.astro';
import LigneNote from '../../components/LigneNote.astro';
import { STATUTS_NOTE, getNotes, sujetsNotes } from '../../lib/contenu';

const notes = await getNotes();
const { sujets } = await sujetsNotes();
const legende = Object.values(STATUTS_NOTE);
---

<Base
  title="Notes · Bénaja Bendo-Matondo"
  description="Mes notes techniques, datées : des problèmes rencontrés et la façon dont je les ai réglés."
>
  <section class="container">
    <p class="eyebrow">Notes</p>
    <h1>Mes notes techniques</h1>
    <p class="lead">
      Des problèmes que j’ai rencontrés et la façon dont je les ai réglés,
      datés pour qu’on sache s’ils sont encore à jour.
    </p>

    {/* A6 — même déplacement que sur /realisations : les sujets ouvrent la
        rubrique au lieu de la clore. On cherche une note par son sujet
        (« CSP », « HTTP »), pas en descendant une liste chronologique. */}
    {
      sujets.length > 0 && (
        <div class="filtres">
          <p class="etiq">Par sujet</p>
          <ul class="chips chips-compte" aria-label="Sujets">
            {sujets.map((groupe) => (
              <li>
                <a href={`/notes/sujet/${groupe.slug}`}>
                  {groupe.label}
                  <span class="compte">{groupe.entrees.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="container">
    <div class="lignes">
      {notes.map((note) => <LigneNote note={note} />)}
    </div>

    {
      notes.length === 0 && (
        <p class="etat-vide">
          Aucune note publiée pour l’instant. Une note paraît quand elle aide à
          retrouver ou comprendre quelque chose, pas à date fixe.
        </p>
      )
    }
  </section>

  <section class="container">
    <p class="eyebrow">Lire les statuts</p>
    <h2>Ce que vaut une note</h2>
    <p class="lead muted">
      Le niveau de finition est affiché parce qu’il change ce que vous pouvez
      en faire.
    </p>
    <dl class="legende">
      {
        legende.map((statut) => (
          <div>
            <dt>{statut.label}</dt>
            <dd>{statut.aide}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* A8 — une sortie qui avance, en plus du flux RSS. */}
  <section class="container">
    <h2>Suivre les nouvelles notes</h2>
    <p class="lead muted">Elles arrivent aussi dans le flux RSS, avec mes réalisations.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/rss.xml">Suivre en RSS</a>
      <a class="btn btn-ghost" href="/realisations">Voir mes réalisations</a>
    </div>
    <p class="haut-de-page"><a href="#contenu">↑ Haut de page</a></p>
  </section>
</Base>
