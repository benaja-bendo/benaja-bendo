---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Statut from '../../components/Statut.astro';
import Taxo from '../../components/Taxo.astro';
import Suite from '../../components/Suite.astro';
import Illustration from '../../components/Illustration.astro';
import {
  STATUTS_NOTE,
  dateISO,
  formatDate,
  getNotes,
  sujetsNotes,
  voisinage,
  type Note,
} from '../../lib/contenu';

/**
 * Une illustration ne se pose que si elle explique une idée précise (docs/05
 * §2). Ici : la CSP est la seule chose du site qui parle de menace, elle mérite
 * d'avoir un visage. Les autres notes n'en ont pas, et c'est très bien.
 */
const ILLUSTRATIONS: Record<string, { nom: string; legende: string; aide: string; meta: string }> = {
  'api-fonts-astro-csp': {
    nom: 'attacker-hood',
    legende: 'Une CSP stricte se paie en confort de build.',
    aide: 'C’est le prix à payer pour qu’un style injecté n’ait aucune chance.',
    meta: 'csp',
  },
};

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { data } = note;
const { Content } = await render(note);
const statut = STATUTS_NOTE[data.statut];
const { aUnePage } = await sujetsNotes();

// Une note obsolète doit pointer sa remplaçante, sinon elle induit en erreur.
const notes = await getNotes();

// A2 — une mémoire de travail se parcourt : on doit pouvoir passer à la note
// suivante sans repasser par l'index. L'ordre est celui de la collection, donc
// du plus récent au plus ancien.
const voisins = voisinage(notes, note.id, '/notes', (n) => n.data.titre);

const illustration = ILLUSTRATIONS[note.id];
const remplacante = data.remplaceePar
  ? notes.find((n) => n.id === data.remplaceePar)
  : undefined;
---

<Base title={`${data.titre} — note | Bénaja Bendo-Matondo`} description={data.resume}>
  <section class="container">
    <p class="eyebrow">Note · <time datetime={dateISO(data.date)}>{formatDate(data.date)}</time></p>
    <h1>{data.titre}</h1>

    <p class="note-statut">
      <Statut label={statut.label} ton={statut.ton} />
      <span class="muted">{statut.aide}</span>
    </p>

    {
      remplacante && (
        <p class="note-cadre">
          Cette note est remplacée par{' '}
          <a href={`/notes/${remplacante.id}`}>{remplacante.data.titre}</a>.
        </p>
      )
    }

    <p class="lead">{data.resume}</p>

    {
      illustration && (
        <Illustration
          nom={illustration.nom}
          legende={illustration.legende}
          aide={illustration.aide}
          meta={illustration.meta}
          taille="petit"
          class="illustration-cote"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      data.sources.length > 0 && (
        <div class="prose">
          <h2>Sources</h2>
          <ul>
            {data.sources.map((source) => (
              <li>
                <a href={source.url} rel="noopener">
                  {source.label} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="container">
    <p class="eyebrow">Repères</p>
    <h2>Sujets</h2>
    <Taxo
      valeurs={data.sujets}
      base="/notes/sujet"
      aUnePage={aUnePage}
      etiquette="Sujets"
    />

    <p class="relecture">
      Écrite le <time datetime={dateISO(data.date)}>{formatDate(data.date)}</time>{
        data.maj && (
          <>
            , relue le <time datetime={dateISO(data.maj)}>{formatDate(data.maj)}</time>
          </>
        )
      }.
    </p>
  </section>

  <Suite
    voisinage={voisins}
    indexHref="/notes"
    indexLabel="Toutes les notes"
  />
</Base>
