---
import Base from '../../layouts/Base.astro';
import { getEtudes, getRealisations } from '../../lib/contenu';

const etudes = await getEtudes();

// F5 — le coin d'accent d'une carte dit « ça tourne aujourd'hui ». L'information
// vit sur la réalisation, pas sur l'étude : on va la chercher là où elle est
// plutôt que de la recopier dans un second frontmatter qui se périmerait.
const realisations = await getRealisations();
const enProduction = new Set(
  realisations
    .filter((r) => r.data.statut === 'production')
    .map((r) => r.data.etude)
    .filter((etude): etude is string => Boolean(etude)),
);
---

<Base
  title="Études de cas · Bénaja Bendo-Matondo"
  description="Les décisions derrière quelques réalisations : le problème, mon rôle, les compromis assumés, le résultat et ce que je ferais autrement aujourd’hui."
>
  <section class="container">
    <p class="eyebrow">Études de cas</p>
    <h1>Les décisions, pas seulement le résultat</h1>
    <p class="lead">
      Trois contextes pour comprendre les problèmes rencontrés, mon rôle et les
      décisions que le résultat seul ne montre pas.
    </p>
  </section>

  <section class="container">
    {
      etudes.length === 0 && (
        <p class="etat-vide">
          Aucune étude publiée pour l’instant.
          <a href="/realisations">L’inventaire des réalisations</a> reste lisible.
        </p>
      )
    }

    <div class="cards">
      {
        etudes.map((etude) => (
          <article class:list={['card', enProduction.has(etude.id) && 'card-live']}>
            {/* h2 : ces cartes suivent directement le h1 de la page. */}
            <h2 class="card-titre">
              <a href={`/etudes/${etude.id}`}>{etude.data.titre}</a>
            </h2>
            {/* Le cadre d'exercice, affiché ici et pas seulement sur la fiche :
                sans lui, la page se lit comme une liste de clients plutôt que
                comme des missions situées. La donnée existait déjà dans le frontmatter et
                n'était rendue nulle part. */}
            {etude.data.sousTitre && (
              <p class="card-cadre">{etude.data.sousTitre}</p>
            )}
            <span class="period">{etude.data.periode}</span>
            <p class="card-resume">{etude.data.resume}</p>
            <a href={`/etudes/${etude.id}`}>Lire l’étude →</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container">
    <p class="eyebrow">Voir aussi</p>
    <h2>L’inventaire complet</h2>
    <p class="lead muted">
      Toutes les réalisations n’ont pas une étude&nbsp;: certaines tiennent en une
      fiche, et c’est très bien ainsi.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/realisations">Voir les réalisations</a>
      <a class="btn btn-ghost" href="/contact">Parler d’un poste ou d’un besoin</a>
    </div>
    <p class="haut-de-page"><a href="#contenu">↑ Haut de page</a></p>
  </section>
</Base>
