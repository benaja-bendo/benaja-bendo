---
import Base from '../layouts/Base.astro';
import Statut from '../components/Statut.astro';
import SourceIllustration from '../components/SourceIllustration.astro';
import StackVisuelle from '../components/StackVisuelle.astro';
import { DISPONIBILITE } from '../lib/parcours';
import {
  STATUTS_REALISATION,
  getRealisations,
} from '../lib/contenu';

// L'accueil sélectionne deux preuves complémentaires : un produit public porté
// de bout en bout et une mission d'entreprise confidentielle mais mesurable.
// Les notes restent accessibles dans la navigation ; les mettre au même niveau
// qu'une preuve de livraison ralentissait le parcours recrutement / mission.
const realisations = await getRealisations();
const travaux = ['mibeko', 'france-travail-collecte']
  .map((id) => realisations.find((entree) => entree.id === id))
  .filter((entree) => entree !== undefined);
---

<Base
  title="Bénaja Bendo-Matondo — développeur fullstack, Bordeaux"
  description="Développeur fullstack Java / Spring Boot · React à Bordeaux. Je construis des systèmes logiciels et je les fais tenir en production : Mibeko, SaaS LegalTech opéré seul depuis décembre 2025 ; services Spring Boot et décisionnel chez Capgemini."
>
  <section class="hero container">
    <div class="hero-layout">
      <div class="hero-copy">
        <p class="eyebrow">Produit · back-end · production</p>
        {/* Trait d'union insécable (U+2011) : sur 375 px, `text-wrap: balance`
            coupait volontiers « Bénaja Bendo- / Matondo » — une césure sur son
            propre nom, en première ligne de la page d'accueil. */}
        <h1>
          Bénaja Bendo‑Matondo
          <span class="role">
            Développeur fullstack Java / Spring Boot · Bordeaux
          </span>
        </h1>

        <p class="hero-value">
          Je transforme des processus métier fragiles en services fiables, et je
          porte mes propres produits jusqu’en production.
        </p>

        {/* La mission citée ici doit être la mission EN COURS. La version
            précédente disait au présent « microservices Java / Spring Boot […]
            sur des systèmes des finances publiques » : c'est l'AIFE, terminée
            en 2024 d'après notre propre étude de cas. Un lecteur qui enchaînait
            l'accueil puis /etudes voyait l'écart de deux ans — exactement ce que
            la règle de contenu n°1 interdit. */}
        <div class="hero-proof hero-proof-split" aria-label="Deux preuves de travail">
          <div class="hero-proof-item">
            <p class="hero-proof-label">Produit livré et opéré</p>
            <p>
              <a href="/etudes/mibeko">Mibeko</a>&nbsp;: assistant juridique sourcé,
              <mark>porté seul</mark> jusqu’aux stores et à la production.
            </p>
          </div>
          <div class="hero-proof-item">
            <p class="hero-proof-label">Expérience en équipe</p>
            <p>
              Chez <strong>Capgemini</strong>&nbsp;: Java&nbsp;/&nbsp;Spring Boot et décisionnel
              pour France Travail&nbsp;; microservices finances publiques auparavant.
            </p>
          </div>
        </div>

        <dl class="hero-facts" aria-label="Repères rapides">
          <div>
            <dt>Depuis 2023</dt>
            <dd>Capgemini</dd>
          </div>
          <div>
            <dt>Depuis déc. 2025</dt>
            <dd>Mibeko en production</dd>
          </div>
          <div>
            <dt><time datetime={DISPONIBILITE.iso}>{DISPONIBILITE.texte}</time></dt>
            <dd>Disponible en CDI</dd>
          </div>
        </dl>

        <div class="cta-row">
          <a class="btn btn-primary" href="#travaux-selectionnes">Voir les preuves</a>
          <a class="btn btn-ghost" href="/cv">Consulter le CV</a>
        </div>
      </div>

      <div class="hero-art">
        <SourceIllustration />
      </div>
    </div>
  </section>

  <section class="container" id="travaux-selectionnes">
    <p class="eyebrow">Travaux sélectionnés</p>
    <h2>Deux contextes, deux preuves</h2>
    <p class="lead muted">
      Un produit public pour juger l’autonomie de bout en bout. Une mission en
      entreprise pour juger l’impact dans un cadre collectif et confidentiel.
    </p>

    <div class="cards cards-selection">
      {travaux.map((travail, index) => {
        const statut = STATUTS_REALISATION[travail.data.statut];
        const href = travail.data.etude
          ? `/etudes/${travail.data.etude}`
          : `/realisations/${travail.id}`;
        return (
          <article class="card door-card">
            <div class="door-card-head">
              <span class="period">{travail.data.periode}</span>
              <span class="door-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <h3><a href={href}>{travail.data.nom}</a></h3>
            <p class="card-cadre">Mon rôle · {travail.data.role}</p>
            <p class="card-resume">{travail.data.resume}</p>
            <p class="card-statut">
              <Statut label={statut.label} ton={statut.ton} />
            </p>
            <a href={href}>Lire l’étude de cas →</a>
          </article>
        );
      })}
    </div>

    <p class="section-link">
      <a href="/realisations">Voir tout l’inventaire des réalisations →</a>
    </p>
  </section>

  {/* La stack vient après les preuves : elle permet le scan par mots-clés sans
      demander au lecteur de croire une liste avant d'avoir vu le travail. */}
  <section class="container">
    <p class="eyebrow">Compétences en contexte</p>
    <h2>Une stack reliée à du travail réel</h2>
    <p class="lead muted">
      Java, Spring Boot, React, Kotlin, Laravel et l’exploitation qui les fait
      tenir. Chaque technologie ci-dessous est utilisée dans une mission ou un
      produit décrit sur ce site.
    </p>
    <StackVisuelle variante="compacte" />
    <p class="section-link">
      <a href="/cv">Voir la stack complète dans le CV →</a>
    </p>
  </section>

  <section class="container">
    <p class="eyebrow">En deux mots</p>
    <h2>J’ai commencé par réparer des machines</h2>
    <div class="prose">
      <p>
        Licence de génie des systèmes industriels à Pointe-Noire, puis le
        développement — chez un employeur, en freelance, et aujourd’hui en
        alternance chez Capgemini à Bordeaux. Le fil conducteur n’a pas bougé&nbsp;:
        comprendre un problème réel, construire l’outil qui le règle, et le
        faire tenir dans la durée.
      </p>
      <p><a href="/parcours">Lire le parcours →</a></p>
    </div>
  </section>

  <section class="container">
    <p class="eyebrow">Pratique</p>
    <h2>Disponibilité</h2>
    <p class="lead">
      Je termine mon alternance chez Capgemini et je serai disponible en CDI à
      partir du <mark class="mark-time mark-ponct">{DISPONIBILITE.texte}</mark>, à
      &nbsp;{DISPONIBILITE.lieu}.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/contact">Parler d’un poste ou d’un besoin</a>
      <a class="btn btn-ghost" href="/cv">Voir le CV</a>
    </div>
  </section>
</Base>
