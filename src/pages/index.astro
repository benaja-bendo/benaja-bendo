---
import Base from '../layouts/Base.astro';
import Statut from '../components/Statut.astro';
import SourceIllustration from '../components/SourceIllustration.astro';
import StackVisuelle from '../components/StackVisuelle.astro';
import Disponibilite from '../components/Disponibilite.astro';
import { CONTACT } from '../lib/parcours';
import {
  STATUTS_REALISATION,
  getRealisations,
} from '../lib/contenu';

// L'accueil sélectionne deux preuves complémentaires : un produit public porté
// de bout en bout et une mission d'entreprise confidentielle mais mesurable.
// Les notes restent accessibles dans la navigation ; les mettre au même niveau
// qu'une preuve de livraison ralentissait le parcours recrutement / mission.
const realisations = await getRealisations();
const travaux = ['mibeko', 'france-travail-collecte']
  .map((id) => realisations.find((entree) => entree.id === id))
  .filter((entree) => entree !== undefined);
---

<Base
  title="Bénaja Bendo-Matondo, développeur fullstack confirmé"
  description="Développeur fullstack confirmé avec 6 ans d’expérience, surtout en Java / Spring Boot et React / TypeScript. Passé par Capgemini, créateur de Mibeko."
>
  <section class="hero container">
    <div class="hero-layout">
      <div class="hero-copy">
        {/* La disponibilité prend la place du sur-titre « Produit · back-end ·
            production » (30/09/2026) : c'est la seule information du haut de
            page qui change la décision d'écrire. */}
        <Disponibilite />
        {/* Trait d'union insécable (U+2011) : sur 375 px, `text-wrap: balance`
            coupait volontiers « Bénaja Bendo- / Matondo » — une césure sur son
            propre nom, en première ligne de la page d'accueil. */}
        <h1>
          Bénaja Bendo‑Matondo
          <span class="role">Développeur fullstack confirmé</span>
        </h1>

        {/* Réécrit le 30/09/2026 à partir d'une phrase dictée par Bénaja
            (docs/13 §2) : sa voix, corrigée, pas une formule. */}
        <p class="hero-value">
          Avec six ans d’expérience, je suis aujourd’hui capable de travailler
          sur des projets complexes et de rendre fiable un produit bancal.
          J’utilise surtout Java&nbsp;/&nbsp;Spring Boot et React.
        </p>

        {/* La mission citée ici doit être la mission EN COURS. La version
            précédente disait au présent « microservices Java / Spring Boot […]
            sur des systèmes des finances publiques » : c'est l'AIFE, terminée
            en 2024 d'après notre propre étude de cas. Un lecteur qui enchaînait
            l'accueil puis /etudes voyait l'écart de deux ans — exactement ce que
            la règle de contenu n°1 interdit. */}
        <div class="hero-proof hero-proof-split" aria-label="Deux projets">
          <div class="hero-proof-item">
            <p class="hero-proof-label">Mon produit</p>
            <p>
              <a href="/realisations/mibeko">Mibeko</a>&nbsp;: une application pour
              que les gens au Congo accèdent facilement aux textes de loi. Je l’ai <mark>créée et publiée</mark> sur l’App Store et Google Play.
            </p>
          </div>
          <div class="hero-proof-item">
            <p class="hero-proof-label">En entreprise</p>
            <p>
              Chez <strong>Capgemini</strong>, pour France Travail&nbsp;: un cycle
              qui concernait plus de 400 collaborateurs est passé d’environ
              10 jours à 48 heures, avec Java&nbsp;/&nbsp;Spring Boot.
            </p>
          </div>
        </div>

        {/* A4 — jusqu'au 25/08/2026, mibeko.fr, GitHub et LinkedIn n'existaient
            que dans le pied de page. Pour un profil de développeur, un produit
            qu'on peut ouvrir et un dépôt qu'on peut lire sont des preuves de
            premier rang, pas des mentions légales : elles arrivent donc dans le
            premier écran. Trois liens, pas six — au-delà, plus rien ne ressort. */}
        <ul class="hero-liens" aria-label="Liens">
          <li><a href="https://mibeko.fr" rel="noopener">mibeko.fr ↗</a></li>
          <li><a href={`https://${CONTACT.github}`} rel="me noopener">GitHub ↗</a></li>
          {/* Forme `www.` comme le pied de page et /contact : `CONTACT.linkedin`
              sert à AFFICHER l'adresse (sur le CV), pas à la lier. Deux formes
              d'URL pour le même profil, c'est deux entrées dans les stats et un
              détail qui se voit à la relecture. */}
          <li><a href="https://www.linkedin.com/in/benaja-bendo" rel="me noopener">LinkedIn ↗</a></li>
        </ul>

        <dl class="hero-facts" aria-label="Repères rapides">
          {/* 30/09/2026 : le nombre de tests (« ~730 ») et la date de
              disponibilité ont quitté ces cases. Le premier ne dit rien à un
              lecteur non technique ; la seconde est passée en tête de page. */}
          <div>
            <dt>6 ans</dt>
            <dd>d’expérience, de Pointe-Noire à Bordeaux</dd>
          </div>
          <div>
            <dt>iOS + Android</dt>
            <dd>Mibeko publié sur les deux stores</dd>
          </div>
          <div>
            <dt>6 dépôts</dt>
            <dd>de code public pour Mibeko</dd>
          </div>
        </dl>

        <div class="cta-row">
          <a class="btn btn-primary" href="#travaux-selectionnes">Voir mes projets</a>
          <a class="btn btn-ghost" href="/cv">Voir le CV</a>
        </div>
      </div>

      <div class="hero-art hero-art-desktop">
        <SourceIllustration />
      </div>
    </div>
  </section>

  <section class="container" id="travaux-selectionnes">
    {/* Plus de sur-titre au-dessus des sections (30/09/2026) : un sur-titre
        par section donnait au site l'allure d'une page générée. Il n'en
        reste qu'un, en haut de chaque page (docs/13 §2). */}
    <h2>Deux projets pour commencer</h2>
    <p class="lead muted">
      Mibeko, une application que j’ai créée pour le Congo. Et ma mission chez
      Capgemini pour France Travail, en équipe.
    </p>

    <div class="cards cards-selection">
      {travaux.map((travail, index) => {
        const statut = STATUTS_REALISATION[travail.data.statut];
        const href = `/realisations/${travail.id}`;
        return (
          <article
            class:list={[
              'card',
              'door-card',
              // F5 — « en production » n'est plus seulement une puce à lire :
              // un coin d'accent le rend lisible sans être lu.
              travail.data.statut === 'production' && 'card-live',
            ]}
          >
            <div class="door-card-head">
              <span class="period">{travail.data.periode}</span>
              <span class="door-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <h3><a href={href}>{travail.data.nom}</a></h3>
            <p class="card-cadre">Mon rôle · {travail.data.role}</p>
            <p class="card-resume">{travail.data.resume}</p>
            <p class="card-statut">
              <Statut label={statut.label} ton={statut.ton} />
            </p>
            <a href={href}>Voir le projet →</a>
          </article>
        );
      })}
    </div>

    <div class="hero-art-mobile">
      <SourceIllustration />
    </div>

    <p class="section-link">
      <a href="/realisations">Voir toutes mes réalisations →</a>
    </p>
  </section>

  {/* La stack vient après les preuves : elle permet le scan par mots-clés sans
      demander au lecteur de croire une liste avant d'avoir vu le travail. */}
  <section class="container">
    <h2>Les technos que j’utilise</h2>
    <p class="lead muted">
      Toutes viennent d’un projet ou d’une mission présentés sur ce site.
      Celles qui sont soulignées mènent à la page où je les ai utilisées.
    </p>
    <StackVisuelle variante="compacte" />
  </section>

  <section class="container">
    <h2>J’ai commencé par réparer des machines</h2>
    <div class="prose">
      <p>
        Avant le code, j’ai fait une licence en maintenance industrielle à
        Pointe-Noire. J’ai ensuite été développeur chez InfraOne System puis
        KabimGroup, avant de venir à Bordeaux pour mes études et Capgemini.
      </p>
      <p class="section-link"><a href="/parcours">Lire mon parcours →</a></p>
    </div>
  </section>

  {/* Plus de date ici (30/09/2026) : la disponibilité est dite une fois, en
      haut de page. Et un seul bouton : le CV est déjà proposé en haut de
      page et dans le menu (étape 7 de docs/13). */}
  <section class="container">
    <h2>Un poste ou un projet&nbsp;?</h2>
    <p class="lead">Le plus simple, c’est de m’écrire.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/contact">Me contacter</a>
    </div>
  </section>
</Base>
