---
import Statut from './Statut.astro';
import Taxo from './Taxo.astro';
import {
  STATUTS_NOTE,
  dateISO,
  formatDate,
  sujetsNotes,
  tempsDeLecture,
  type Note,
} from '../lib/contenu';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { id, data } = note;
const statut = STATUTS_NOTE[data.statut];
const { aUnePage } = await sujetsNotes();
---

<article class="ligne">
  <div class="ligne-tete">
    {/* h2 : même raison que dans LigneRealisation — la ligne suit le h1 de la
        page (index des articles, /articles/sujet/…). */}
    <h2 class="ligne-titre">
      <a href={`/articles/${id}`}>{data.titre}</a>
    </h2>
    <Statut label={statut.label} ton={statut.ton} />
  </div>

  <p class="ligne-periode">
    <time datetime={dateISO(data.date)}>{formatDate(data.date)}</time>
    {data.maj && <> · relu le {formatDate(data.maj)}</>}
    {` · ${tempsDeLecture(note.body ?? '')} min de lecture`}
  </p>

  <p class="ligne-resume">{data.resume}</p>

  <Taxo
    valeurs={data.sujets}
    base="/articles/sujet"
    aUnePage={aUnePage}
    etiquette={`Sujets de l’article : ${data.titre}`}
  />

  <p class="ligne-liens">
    <a href={`/articles/${id}`}>Lire l’article →</a>
  </p>
</article>
