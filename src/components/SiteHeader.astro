---
import { estActif, navigationPrincipale } from '../lib/contenu';

// Liste partagée avec le pied de page (src/lib/contenu.ts) : sur mobile,
// l'en-tête masque ces entrées et c'est le pied qui les porte.
const nav = await navigationPrincipale();

const path = Astro.url.pathname;
const isActive = (href: string) => estActif(path, href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="brand-mark" aria-hidden="true">BB</span>
      <span class="brand-name">Bénaja&nbsp;Bendo</span>
    </a>
    <nav aria-label="Navigation principale">
      <ul>
        {nav.map((item) => (
          <li class="nav-section">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav-action">
          <a
            class="nav-cta"
            href="/contact"
            aria-current={isActive('/contact') ? 'page' : undefined}
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
