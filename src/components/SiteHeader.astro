---
import BasculeTheme from './BasculeTheme.astro';
import { estActif, navigationPrincipale } from '../lib/contenu';

// Liste partagée avec le pied de page (src/lib/contenu.ts). Sur mobile, elle
// reste disponible dans un <details> natif : pas de script, pas de commande
// morte, et aucune section à plusieurs milliers de pixels dans le pied de page.
//
// `.header-outils` est rendue à toutes les tailles : elle porte la bascule de
// thème, qui doit rester atteignable sans faire défiler jusqu'au pied de page.
// Seul le menu <details> qu'elle contient disparaît au-dessus de 48rem.
const nav = await navigationPrincipale();

const path = Astro.url.pathname;
const isActive = (href: string) => estActif(path, href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="brand-mark" aria-hidden="true">BB</span>
      <span class="brand-name">Bénaja&nbsp;Bendo</span>
    </a>
    <nav class="navigation-desktop" aria-label="Navigation principale">
      <ul>
        {nav.map((item) => (
          <li class="nav-section">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav-action">
          <a
            class="nav-cta"
            href="/contact"
            aria-current={isActive('/contact') ? 'page' : undefined}
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-outils">
      <BasculeTheme />
      <details class="navigation-mobile">
        <summary>Menu</summary>
        <nav aria-label="Navigation mobile">
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a
                href="/contact"
                aria-current={isActive('/contact') ? 'page' : undefined}
              >
                Contact
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
