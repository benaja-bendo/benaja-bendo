---
import { estActif, navigationPrincipale } from '../lib/contenu';

// Calculée au build, pas écrite en dur : un site statique fige l'année au
// moment de la génération, mais une constante en dur ne se corrige jamais toute
// seule — c'est le mode de panne que l'invariant n°5 interdit, en miniature.
const year = new Date().getFullYear();

// Mêmes entrées que l'en-tête, même source. C'est la SEULE navigation de
// section disponible sur mobile, où l'en-tête se réduit à la marque et à
// Contact — d'où le libellé explicite et les cibles à 44 px.
const nav = await navigationPrincipale();
const path = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-block">
      <p class="footer-status">
        <span class="dot" aria-hidden="true"></span>
        Disponible en CDI à partir du <strong>28 septembre 2026</strong>
      </p>
      <p class="footer-loc">Bordeaux / Mérignac (33), France</p>
    </div>

    <nav class="footer-links footer-sections" aria-label="Sections du site">
      <span class="etiq">Le site</span>
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={estActif(path, item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact" aria-current={estActif(path, '/contact') ? 'page' : undefined}>
        Contact
      </a>
    </nav>

    <nav class="footer-links" aria-label="Contact et liens">
      <span class="etiq">Ailleurs</span>
      <a href="mailto:contact@benaja-bendo.fr">contact@benaja-bendo.fr</a>
      <a href="https://github.com/benaja-bendo" rel="me noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/benaja-bendo" rel="me noopener">LinkedIn</a>
      <a href="/colophon">Colophon</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
  <div class="container footer-legal">
    {/* Masquée tant que public/js/theme.js n'a pas posé `data-theme-pret` sur
        <html> : sans script, ces boutons ne feraient rien. */}
    <div class="theme-commande" data-theme-commande>
      <span class="etiq" id="theme-titre">Thème</span>
      <div class="theme-boutons" role="group" aria-labelledby="theme-titre">
        <button type="button" data-theme-choix="clair" aria-pressed="false">Clair</button>
        <button type="button" data-theme-choix="sombre" aria-pressed="false">Sombre</button>
        <button type="button" data-theme-choix="auto" aria-pressed="true">Système</button>
      </div>
    </div>

    <p>© {year} Bénaja Bendo-Matondo</p>
  </div>
</footer>
