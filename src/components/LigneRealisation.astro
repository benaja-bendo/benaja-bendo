---
import Statut from './Statut.astro';
import {
  STATUTS_REALISATION,
  type Realisation,
} from '../lib/contenu';

/**
 * Une entrée scannable de l'inventaire. L'enseignement et la stack complète
 * restent sur la page du projet : les répéter ici transformait chaque ligne
 * en page.
 */
interface Props {
  realisation: Realisation;
  /**
   * Niveau du titre. 2 quand la ligne suit directement le h1 (pages /tech/…
   * et /domaine/…), 3 sous un titre de groupe (page Réalisations). Un saut de
   * niveau fait manquer une étape à la navigation par titres d'un lecteur
   * d'écran ; la taille vient de `.ligne-titre`, le rendu est identique.
   */
  niveau?: 2 | 3;
  /** Ancre de la ligne, pour les anciennes adresses (/experiences#aife). */
  ancre?: string;
}

const { realisation, niveau = 2, ancre } = Astro.props;
const { id, data } = realisation;
const statut = STATUTS_REALISATION[data.statut];
const Titre = niveau === 3 ? 'h3' : 'h2';
---

<article class="ligne" id={ancre}>
  <div class="ligne-tete">
    <Titre class="ligne-titre">
      <a href={`/realisations/${id}`}>{data.nom}</a>
    </Titre>
    <Statut label={statut.label} ton={statut.ton} />
  </div>
  <p class="ligne-periode">{data.periode}</p>
  <p class="ligne-resume">{data.resume}</p>
  <p class="champ">
    <span class="etiq">Mon rôle</span>
    {data.role}
  </p>
  <p class="ligne-liens">
    <a href={`/realisations/${id}`}>Voir le projet →</a>
    {
      data.liens.map((lien) => (
        <a href={lien.url} rel="noopener">
          {lien.label} ↗
        </a>
      ))
    }
  </p>
</article>
